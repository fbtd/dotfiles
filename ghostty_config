# theme = Catppuccin Latte
# theme = Rose Pine Dawn
theme = Dayfox
# theme = TokyoNight Day
# theme = Everforest Light Med
# theme = TokyoNight Night
# background-opacity = 0.95
# background-opacity = 0.88
alpha-blending = native
background = #FBFBFB
# foreground = #000000
cursor-color = #f52798
selection-background = #f52798
# gtk-adwaita = false
window-decoration = false
# font-family = FiraCode Nerd Font Mono
font-family = FiraCode Nerd Font Mono SemBd
# font-family = JetBrainsMono Nerd Font
font-style = Medium
font-feature = +liga, +calt, +dlig
# ~-  => {} <= != *** //
font-size = 12
minimum-contrast = 1.6
# window-decoration = false
window-show-tab-bar = never
# window-padding-y = 15,0
window-padding-balance = true
confirm-close-surface = false

keybind = clear
# Omarchy Super+C/V injects these into terminals; Super never reaches Ghostty.
keybind = control+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = super+v=paste_from_clipboard
keybind = performable:super+c=copy_to_clipboard
keybind = performable:alt+s>n=new_tab
keybind = performable:alt+s>alt+s=next_tab
keybind = performable:alt+s>s=toggle_tab_overview
keybind = performable:alt+s>p=toggle_command_palette
keybind = performable:alt+s>r=reload_config
keybind = performable:alt+s>i=inspector:toggle
